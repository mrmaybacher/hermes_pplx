# ── Hermes environment ─────────────────────────────────
# Copy to ".env" and fill in. With NO Graph vars set, Hermes runs the
# built-in demo feed. The moment all three GRAPH_* vars are present, it
# switches to your real inbox automatically — no code changes.

# ── Microsoft Graph (real inbox) — from your Azure app registration ──
# Entra ID → App registrations → your app:
#   Overview page          → Directory (tenant) ID  → GRAPH_TENANT_ID
#   Overview page          → Application (client) ID → GRAPH_CLIENT_ID
#   Certificates & secrets → New client secret VALUE → GRAPH_CLIENT_SECRET
# API permissions must include Mail.Read (Application) with admin consent granted.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=hermes@angelsestate.bg

# ── GPT extraction engine (OpenAI) ──────────────────────
# SELF-HOSTING: put your own OpenAI key here and use a real model name below.
#   Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key...
# Model used for extraction. Self-host: use a real OpenAI model.
#   Good choices: gpt-4o (best), gpt-4o-mini (cheapest), gpt-4.1
HERMES_MODEL=gpt-4o
# Optional: point at Azure OpenAI or any OpenAI-compatible gateway.
# Leave blank to use api.openai.com.
OPENAI_BASE_URL=

# ── Watcher behaviour ───────────────────────────────────
# How many days of inbox history to ingest (default 3). Going forward it
# always watches new mail too.
HERMES_LOOKBACK_DAYS=3

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
