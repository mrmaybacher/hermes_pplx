# ── Hermes production environment ──────────────────────────────
# Copy to ".env" on the server and fill in real values.

# Microsoft Graph (your Azure app — Mail.Read application permission + admin consent)
GRAPH_TENANT_ID=32f3364d-7ba2-4d5b-9450-69f6821883f4
GRAPH_CLIENT_ID=39b59ac8-a1b7-42fe-8a18-64b14acf079d
GRAPH_CLIENT_SECRET=replace-with-your-graph-client-secret
GRAPH_MAILBOX=hermes@angelsestate.bg

# OpenAI — your real key. The app uses it directly for GPT-4o extraction.
OPENAI_API_KEY=sk-your-real-openai-key
HERMES_MODEL=gpt-4o

# Polling window: how many days back to scan on each run
HERMES_LOOKBACK_DAYS=3

# App
PORT=5000
NODE_ENV=production
HERMES_DB_PATH=/app/data/data.db

# Cloudflare Tunnel token (from Zero Trust dashboard — see setup guide)
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
